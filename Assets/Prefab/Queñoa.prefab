  m_Script: {fileID: 11500000, guid: 9155d463758dc6249a1662498a3650f0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speciesId: quenoa
  displayName: "Que\xF1oa"
  scientificName: Polylepis tarapacana
  description: "La que\xF1oa es el \xE1rbol que crece a mayor altitud en el mundo,
    resistiendo hasta los 5200 metros en el altiplano andino. Su corteza rojiza se
    desprende en capas delgadas, una adaptaci\xF3n que la protege del fr\xEDo extremo
    y la radiaci\xF3n solar. Para las comunidades aymara, sus bosques \u2014los quenoales\u2014
    son considerados espacios sagrados y una fuente vital de le\xF1a y refugio para
    la fauna altipl\xE1nica."
